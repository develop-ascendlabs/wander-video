---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoreBadges from '../../components/StoreBadges.astro';
---

<BaseLayout
  title="Route videos: famous trips as map animations · Wander"
  description="Cinematic map videos of famous routes, starting with the Dalmatian Coast. Each page will embed a Wander export."
>
  <section class="py-16 md:py-24">
    <div class="container-site max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">Routes</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-ink">Famous route videos</h1>
      <p class="mt-4 text-lg text-ink-muted leading-relaxed">
        One page per itinerary, each with a Wander export. None are up yet. The first will be the
        Dalmatian Coast: Split, Hvar, Dubrovnik, as a boat route.
      </p>
      <p class="mt-4 text-lg text-ink-muted leading-relaxed">
        Until then, make your own from the
        <a href="/blog/how-to-make-a-route-animation-for-tiktok" class="font-semibold text-primary hover:text-primary-dark">TikTok guide</a>
        or the
        <a href="/blog/road-trip-map-animation-maker" class="font-semibold text-primary hover:text-primary-dark">road trip maker</a>.
      </p>

      <div class="mt-12">
        <StoreBadges />
      </div>

      <p class="mt-8">
        <a href="/" class="text-sm font-semibold text-primary hover:text-primary-dark">← Back to home</a>
      </p>
    </div>
  </section>
</BaseLayout>
