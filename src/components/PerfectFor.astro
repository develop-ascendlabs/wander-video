---
const audiences = [
  { label: 'Travel videos', icon: 'camera' },
  { label: 'YouTube', icon: 'play' },
  { label: 'TikTok', icon: 'tiktok' },
  { label: 'Instagram Reels', icon: 'ig' },
  { label: 'Road trips', icon: 'briefcase' },
  { label: 'Flights', icon: 'pin' },
];
---

<section class="py-12 md:py-16">
  <div class="container-site">
    <p class="text-center text-sm font-semibold uppercase tracking-wider text-ink-soft">Built for</p>
    <ul class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6">
      {audiences.map((item) => (
        <li class="flex flex-col items-center gap-3 text-center">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-primary-soft text-primary">
            {item.icon === 'camera' && (
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8.5A1.5 1.5 0 0 1 4.5 7h2.2l1.1-1.8A1.5 1.5 0 0 1 9.1 4.5h5.8a1.5 1.5 0 0 1 1.3.7L17.3 7h2.2A1.5 1.5 0 0 1 21 8.5v9A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5v-9z" /><circle cx="12" cy="13" r="3.25" /></svg>
            )}
            {item.icon === 'play' && (
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5.14v13.72a1 1 0 0 0 1.55.83l10.4-6.86a1 1 0 0 0 0-1.66L9.55 4.31A1 1 0 0 0 8 5.14z" /></svg>
            )}
            {item.icon === 'tiktok' && (
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19.6 6.9A4.9 4.9 0 0 1 16 5.2V15a5 5 0 1 1-5-5c.2 0 .4 0 .6.1v2.3a2.7 2.7 0 1 0 1.9 2.6V2.5h2.5a4.9 4.9 0 0 0 3.6 4.4v2z" /></svg>
            )}
            {item.icon === 'ig' && (
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0-4.8c3.2 0 3.6 0 4.9.1 1.2.1 1.9.2 2.3.4.6.2 1 .5 1.5 1 .4.4.7.9 1 1.5.2.4.4 1.1.4 2.3.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.9-.4 2.3-.2.6-.5 1-1 1.5-.4.4-.9.7-1.5 1-.4.2-1.1.4-2.3.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.9-.2-2.3-.4-.6-.2-1-.5-1.5-1-.4-.4-.7-.9-1-1.5-.2-.4-.4-1.1-.4-2.3C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.9.4-2.3.2-.6.5-1 1-1.5.4-.4.9-.7 1.5-1 .4-.2 1.1-.4 2.3-.4C8.4 2.2 8.8 2.2 12 2.2z" /></svg>
            )}
            {item.icon === 'briefcase' && (
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V5.5A1.5 1.5 0 0 1 9.5 4h5A1.5 1.5 0 0 1 16 5.5V7m-11 0h14a1.5 1.5 0 0 1 1.5 1.5V18A1.5 1.5 0 0 1 19 19.5H5A1.5 1.5 0 0 1 3.5 18V8.5A1.5 1.5 0 0 1 5 7z" /></svg>
            )}
            {item.icon === 'pin' && (
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-5.3 7-11a7 7 0 1 0-14 0c0 5.7 7 11 7 11z" /><circle cx="12" cy="10" r="2.25" /></svg>
            )}
          </div>
          <span class="text-sm font-medium text-ink">{item.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
