---
import StoreBadges from './StoreBadges.astro';
---

<section class="py-12 md:py-16">
  <div class="container-site">
    <div class="rounded-3xl bg-primary-soft px-6 py-12 text-center md:px-12 md:py-16">
      <h2 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">
        Start creating beautiful travel videos.
      </h2>
      <p class="mx-auto mt-3 max-w-lg text-ink-muted">
        Download Wander and turn your next route into a cinematic map video.
      </p>
      <div class="mt-8 flex justify-center">
        <StoreBadges />
      </div>
    </div>
  </div>
</section>
