---
import StoreBadges from './StoreBadges.astro';
---

<section class="py-12 md:py-16">
  <div class="container-site">
    <div class="rounded-3xl bg-primary-soft px-6 py-12 text-center md:px-12 md:py-16">
      <h2 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">
        Export a video from a route.
      </h2>
      <p class="mx-auto mt-3 max-w-lg text-ink-muted">
        Free on Google Play. Paste a maps link, pick a style, export 1080p or 4K. iPhone coming soon.
      </p>
      <div class="mt-8 flex justify-center">
        <StoreBadges />
      </div>
    </div>
  </div>
</section>
