---
import AppScreenshot from './AppScreenshot.astro';

const steps = [
  {
    title: 'Create your route',
    body: 'Paste a maps link, import GPX, or tap stops on the map.',
    img: '/images/app/route-editor.png',
    alt: 'Wander route editor with stops along the Garden Route in South Africa',
  },
  {
    title: 'Choose a style and vehicle',
    body: 'Pick from 18 map styles and an animated vehicle.',
    img: '/images/app/style.png',
    alt: 'Wander style picker with topographic, satellite, and glow settings',
  },
  {
    title: 'Export your video',
    body: '9:16 for Reels and TikTok, 1:1 square, or 16:9 landscape. 1080p, or 4K on Pro.',
    img: '/images/app/export.png',
    alt: 'Wander export screen with aspect ratio and resolution options',
  },
];
---

<section class="py-12 md:py-20 bg-surface-muted/60">
  <div class="container-site">
    <h2 class="text-center text-3xl font-bold tracking-tight text-ink md:text-4xl">How it works</h2>

    <ol class="mt-12 grid gap-8 md:grid-cols-3 md:gap-6">
      {steps.map((step, i) => (
        <li class="relative">
          {i < steps.length - 1 && (
            <div
              class="pointer-events-none absolute top-24 right-0 hidden w-8 translate-x-1/2 border-t-2 border-dashed border-primary/40 md:block lg:w-16"
              aria-hidden="true"
            ></div>
          )}
          <div class="overflow-hidden rounded-2xl border border-border bg-surface shadow-sm">
            <div class="flex justify-center bg-ink px-6 pt-6">
              <div class="w-full max-w-[220px] overflow-hidden rounded-xl aspect-[9/16]">
                <AppScreenshot src={step.img} alt={step.alt} />
              </div>
            </div>
            <div class="p-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-primary">Step {i + 1}</p>
              <h3 class="mt-1 text-lg font-bold text-ink">{step.title}</h3>
              <p class="mt-2 text-sm text-ink-muted">{step.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
