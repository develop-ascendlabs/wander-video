---
import AutoplayVideo from './AutoplayVideo.astro';
---

<section class="py-8 md:py-12">
  <div class="container-site">
    <div class="relative overflow-hidden rounded-3xl border border-ink/20 bg-ink min-h-[280px] md:min-h-[360px]">
      <AutoplayVideo
        name="garden-banner"
        fallback="/images/stills/garden.jpg"
        alt="Garden Route map video export with a car following the South African coast"
        class="absolute inset-0 h-full w-full object-cover opacity-80"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-ink/80 via-ink/50 to-ink/20"></div>
      <div class="relative flex h-full min-h-[280px] md:min-h-[360px] items-end p-8 md:p-12">
        <p class="max-w-xl text-xl font-semibold leading-snug text-white md:text-2xl">
          Paste a route, pick a map style and a vehicle, then export a video. Free is 1080p with a watermark. Pro is 4K without one.
        </p>
      </div>
    </div>
  </div>
</section>
