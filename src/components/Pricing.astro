---
import { site, product } from '../config/site';

const freeFeatures = [
  '1080p export with watermark',
  `All ${product.styleCount} map styles`,
  `Vehicles: ${product.freeVehicles}`,
  `Up to ${product.freeProjects} projects`,
  `Up to ${product.freeStops} stops per project`,
  'Cloud sync with an account',
];

const proFeatures = [
  '4K export, no watermark',
  'Every vehicle, including campervan, bus, SUV & motorcycle',
  'Unlimited projects and stops',
  'Same cloud sync and map styles',
  'Paid extras as we add them',
];
---

<section id="pricing" class="scroll-mt-20 py-16 md:py-24">
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">Free and Pro</h2>
      <p class="mt-3 text-ink-muted">Free on Google Play. Pro is for 4K and no watermark.</p>
    </div>

    <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
      <article class="rounded-3xl border border-border bg-surface p-8 shadow-sm">
        <h3 class="text-xl font-bold text-ink">Free</h3>
        <p class="mt-2 text-sm text-ink-muted">1080p with a watermark. Five projects.</p>
        <p class="mt-6">
          <span class="text-4xl font-bold text-ink">£0</span>
          <span class="text-ink-muted"> / forever</span>
        </p>
        <ul class="mt-8 space-y-3">
          {freeFeatures.map((f) => (
            <li class="flex items-start gap-2 text-sm text-ink">
              <span class="mt-0.5 text-primary" aria-hidden="true">✓</span>
              {f}
            </li>
          ))}
        </ul>
        <a
          href={site.playStoreUrl}
          rel="noopener noreferrer"
          class="mt-8 flex w-full items-center justify-center rounded-xl border-2 border-primary px-4 py-3 text-sm font-semibold text-primary hover:bg-primary-soft transition-colors"
        >
          Get it on Google Play
        </a>
      </article>

      <article class="relative rounded-3xl border border-primary bg-primary p-8 text-white shadow-lg shadow-primary/30">
        <h3 class="text-xl font-bold">Pro</h3>
        <p class="mt-2 text-sm text-white/80">4K exports without a watermark.</p>
        <p class="mt-6">
          <span class="text-4xl font-bold">{product.proMonthly}</span>
          <span class="text-white/80"> / month</span>
        </p>
        <p class="mt-1 text-xs text-white/70">Or {product.proYearly} / year</p>
        <ul class="mt-8 space-y-3">
          {proFeatures.map((f) => (
            <li class="flex items-start gap-2 text-sm">
              <span class="mt-0.5 text-white" aria-hidden="true">✓</span>
              {f}
            </li>
          ))}
        </ul>
        <a
          href={site.playStoreUrl}
          rel="noopener noreferrer"
          class="mt-8 flex w-full items-center justify-center rounded-xl bg-white px-4 py-3 text-sm font-semibold text-primary hover:bg-primary-soft transition-colors"
        >
          Start Pro on Google Play
        </a>
      </article>
    </div>
  </div>
</section>
