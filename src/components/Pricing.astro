---
import { site } from '../config/site';

const freeFeatures = [
  '1080p export',
  '2 map styles (Golden Hour & Midnight Drive)',
  'Watermark on videos',
  'Up to 5 projects',
  'Car, plane & bicycle',
];

const proFeatures = [
  '4K export',
  'All map styles & vehicles',
  'No watermark',
  'Unlimited projects',
  'Future Pro features first',
];
---

<section id="pricing" class="scroll-mt-20 py-16 md:py-24">
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">Simple pricing</h2>
      <p class="mt-3 text-ink-muted">Start free. Upgrade when you’re ready to create without limits.</p>
    </div>

    <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
      <article class="rounded-3xl border border-border bg-surface p-8 shadow-sm">
        <h3 class="text-xl font-bold text-ink">Free</h3>
        <p class="mt-2 text-sm text-ink-muted">Perfect for trying out Wander.</p>
        <p class="mt-6">
          <span class="text-4xl font-bold text-ink">£0</span>
          <span class="text-ink-muted"> / forever</span>
        </p>
        <ul class="mt-8 space-y-3">
          {freeFeatures.map((f) => (
            <li class="flex items-start gap-2 text-sm text-ink">
              <span class="mt-0.5 text-primary" aria-hidden="true">✓</span>
              {f}
            </li>
          ))}
        </ul>
        <a
          href={site.playStoreUrl}
          class="mt-8 flex w-full items-center justify-center rounded-xl border-2 border-primary px-4 py-3 text-sm font-semibold text-primary hover:bg-primary-soft transition-colors"
        >
          Get Started
        </a>
      </article>

      <article class="relative rounded-3xl border border-primary bg-primary p-8 text-white shadow-lg shadow-primary/30">
        <span class="absolute -top-3 right-6 rounded-full bg-white px-3 py-1 text-xs font-bold text-primary">
          Most Popular
        </span>
        <h3 class="text-xl font-bold">Pro</h3>
        <p class="mt-2 text-sm text-white/80">Unlock everything and create without limits.</p>
        <p class="mt-6">
          <span class="text-4xl font-bold">£4.99</span>
          <span class="text-white/80"> / month</span>
        </p>
        <p class="mt-1 text-xs text-white/70">Or £24.99 / year</p>
        <ul class="mt-8 space-y-3">
          {proFeatures.map((f) => (
            <li class="flex items-start gap-2 text-sm">
              <span class="mt-0.5 text-white" aria-hidden="true">✓</span>
              {f}
            </li>
          ))}
        </ul>
        <a
          href={site.playStoreUrl}
          class="mt-8 flex w-full items-center justify-center rounded-xl bg-white px-4 py-3 text-sm font-semibold text-primary hover:bg-primary-soft transition-colors"
        >
          Try Pro
        </a>
      </article>
    </div>
  </div>
</section>
