---
const features = [
  {
    title: '18 map styles',
    body: 'Topographic, Golden Hour, Midnight Drive, Film, satellite, and the rest. All of them are on Free.',
    soon: false,
    icon: 'styles',
  },
  {
    title: 'Animated vehicles',
    body: 'Car, plane, bicycle, train, and boat on Free. Campervan, bus, SUV, and motorcycle with Pro.',
    soon: false,
    icon: 'vehicle',
  },
  {
    title: 'Route editor',
    body: 'Tap stops, paste a Google or Apple Maps link, or search places to build a path.',
    soon: false,
    icon: 'route',
  },
  {
    title: 'Flight Mode',
    body: 'Great-circle arcs for flights between cities and continents.',
    soon: false,
    icon: 'flight',
  },
  {
    title: 'GPX Import',
    body: 'Drop in a GPX file from your hike, ride, or road trip.',
    soon: false,
    icon: 'gpx',
  },
  {
    title: '1080p and 4K export',
    body: 'Free is 1080p with a watermark. Pro is 4K with no watermark.',
    soon: false,
    icon: 'export',
  },
  {
    title: 'Android app',
    body: 'The whole flow runs on your phone. iPhone coming soon.',
    soon: false,
    icon: 'mobile',
  },
  {
    title: 'Cloud sync',
    body: 'Sign in to keep projects in sync across devices.',
    soon: false,
    icon: 'cloud',
  },
];
---

<section class="py-16 md:py-24">
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">What's in the app</h2>
      <p class="mt-3 text-ink-muted">Build a route, pick a style, export a video.</p>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((f) => (
        <li class="rounded-2xl border border-border bg-surface p-5">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-primary/30 text-primary">
            {f.icon === 'styles' && (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
            )}
            {f.icon === 'vehicle' && (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 16V9.5A1.5 1.5 0 0 1 6.5 8H9l1.2-2.4A1.5 1.5 0 0 1 11.5 5h1a1.5 1.5 0 0 1 1.3.6L15 8h2.5A1.5 1.5 0 0 1 19 9.5V16M5 16h14M7.5 18.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm9 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" /></svg>
            )}
            {f.icon === 'route' && (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><circle cx="6" cy="18" r="2.25" /><circle cx="18" cy="6" r="2.25" /><path stroke-linecap="round" d="M8 16.5c2-4 4-6 8-8.5" /></svg>
            )}
            {f.icon === 'flight' && (
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5L21 16z" /></svg>
            )}
            {f.icon === 'gpx' && (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9l-5-6z" /><path stroke-linecap="round" d="M14 3v6h6" /></svg>
            )}
            {f.icon === 'export' && (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14" /></svg>
            )}
            {f.icon === 'mobile' && (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="2" /><path stroke-linecap="round" d="M11 18h2" /></svg>
            )}
            {f.icon === 'cloud' && (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 18h10a4 4 0 0 0 .5-8 5.5 5.5 0 0 0-10.7 1.5A3.5 3.5 0 0 0 7 18z" /></svg>
            )}
          </div>
          <div class="mt-4 flex items-center gap-2">
            <h3 class="font-semibold text-ink">{f.title}</h3>
            {f.soon && (
              <span class="rounded-full bg-primary-soft px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-primary">Soon</span>
            )}
          </div>
          <p class="mt-2 text-sm text-ink-muted leading-relaxed">{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
