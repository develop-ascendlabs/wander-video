---
import AutoplayVideo from './AutoplayVideo.astro';

const phones = [
  {
    label: 'Causeway Coast',
    img: '/images/stills/causeway.jpg',
    caption: 'Car, satellite',
    video: 'causeway',
    alt: 'Causeway Coastal Route with a car on satellite map',
  },
  {
    label: 'Garden Route',
    img: '/images/stills/garden.jpg',
    caption: 'Car, topographic',
    video: 'garden',
    alt: 'Garden Route with a car on a topographic map',
  },
  {
    label: 'Athens to Crete',
    img: '/images/stills/athens.jpg',
    caption: 'Plane, light map',
    video: 'athens',
    alt: 'Athens to Crete flight on a light map style',
  },
  {
    label: 'Queenstown to Milford',
    img: '/images/stills/queenstown.jpg',
    caption: 'Plane, satellite',
    video: 'queenstown',
    alt: 'Queenstown to Milford Sound with a plane on satellite map',
  },
  {
    label: 'Tokyo to Kyoto',
    img: '/images/stills/tokyo.jpg',
    caption: 'Train, satellite',
    video: 'tokyo',
    alt: 'Tokyo to Kyoto on a bullet train over satellite map',
  },
];
---

<section class="py-16 md:py-24 overflow-hidden">
  <div class="container-site">
    <h2 class="text-center text-3xl font-bold tracking-tight text-ink md:text-4xl">Example exports</h2>
    <p class="mx-auto mt-3 max-w-xl text-center text-ink-muted">
      These were exported from Wander on a phone. 9:16, 1080p, with the Free watermark.
    </p>

    <div class="mt-12 flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory md:justify-center md:gap-5 md:overflow-visible">
      {phones.map((phone) => (
        <figure class="w-[160px] shrink-0 snap-center sm:w-[180px]">
          <div class="rounded-[1.75rem] border-[3px] border-ink bg-ink p-1.5 shadow-xl shadow-ink/15">
            <div class="overflow-hidden rounded-[1.35rem] bg-surface aspect-[9/16]">
              <div class="relative h-full">
                <AutoplayVideo
                  name={phone.video}
                  fallback={phone.img}
                  alt={phone.alt}
                  preload="none"
                  class="h-full w-full object-cover"
                />
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/70 to-transparent p-3 pt-10">
                  <p class="text-[10px] font-semibold text-white/90">{phone.caption}</p>
                </div>
              </div>
            </div>
          </div>
          <figcaption class="mt-3 text-center text-sm font-medium text-ink">{phone.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
