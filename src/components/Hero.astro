---
import StoreBadges from './StoreBadges.astro';
import AutoplayVideo from './AutoplayVideo.astro';
---

<section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24">
  <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="max-w-xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">Android travel video app</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-ink sm:text-5xl lg:text-[3.25rem] lg:leading-[1.1]">
        Make a map video from a route.
      </h1>
      <p class="mt-5 text-lg text-ink-muted leading-relaxed">
        Paste a Google Maps link, import a GPX, or tap stops on the map. Wander animates a vehicle along the path. Export 1080p with a watermark, or 4K without one, for Instagram, TikTok, and YouTube.
      </p>

      <div class="mt-8">
        <StoreBadges />
      </div>

      <p class="mt-6 text-sm text-ink-muted">
        Free on Google Play. iPhone is not out yet.
      </p>
    </div>

    <div class="relative mx-auto w-full max-w-[280px] sm:max-w-[320px] lg:mx-0 lg:justify-self-end">
      <div class="rounded-[2rem] border-[3px] border-ink bg-ink p-2 shadow-2xl shadow-primary/20">
        <div class="relative overflow-hidden rounded-[1.5rem] aspect-[9/16] bg-surface">
          <AutoplayVideo
            name="causeway"
            fallback="/images/stills/causeway.jpg"
            alt="Wander export of the Causeway Coastal Route in Northern Ireland"
            class="h-full w-full object-cover"
          />
          <div class="absolute top-3 right-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-ink shadow-sm">
            9:16
          </div>
        </div>
      </div>
      <p class="mt-3 text-center text-sm text-ink-muted">
        Causeway Coastal Route. Free export, so it has a watermark.
      </p>
    </div>
  </div>
</section>
