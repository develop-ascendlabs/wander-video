---
import { getBlogPosts, formatDate } from '../lib/content';
import { publicExists } from '../lib/publicFile';

const posts = await getBlogPosts();
---

{
  posts.length > 0 && (
    <section class="py-16 md:py-24 bg-surface">
      <div class="container-site">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-semibold uppercase tracking-wider text-primary">Guides</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink md:text-4xl">From the blog</h2>
          <p class="mt-3 text-ink-muted">
            How to make the video, then post it. Each guide has a Wander export on the page.
          </p>
        </div>

        <ul class="mt-12 grid gap-6 md:grid-cols-3">
          {
            posts.map((post) => {
              const poster = publicExists(`/videos/${post.data.video}.jpg`)
                ? `/videos/${post.data.video}.jpg`
                : '/images/stills/og.jpg';
              return (
                <li>
                  <a
                    href={`/blog/${post.id}`}
                    class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-bg hover:border-primary/40 transition-colors"
                  >
                    <div
                      class:list={[
                        'bg-ink overflow-hidden',
                        post.data.aspect === 'vertical' ? 'aspect-[4/5]' : 'aspect-video',
                      ]}
                    >
                      <img
                        src={poster}
                        alt=""
                        class="h-full w-full object-cover"
                        width="640"
                        height="480"
                      />
                    </div>
                    <div class="flex flex-1 flex-col p-5">
                      <p class="text-xs font-semibold uppercase tracking-wider text-primary">
                        {formatDate(post.data.pubDate)}
                      </p>
                      <h3 class="mt-1 font-bold text-ink group-hover:text-primary transition-colors leading-snug">
                        {post.data.title}
                      </h3>
                      <p class="mt-2 text-sm text-ink-muted leading-relaxed line-clamp-3">
                        {post.data.description}
                      </p>
                    </div>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <p class="mt-8 text-center">
          <a href="/blog" class="text-sm font-semibold text-primary hover:text-primary-dark">
            All guides →
          </a>
        </p>
      </div>
    </section>
  )
}
