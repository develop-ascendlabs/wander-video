---
import AppScreenshot from './AppScreenshot.astro';

const cards = [
  {
    n: '1',
    title: 'Create',
    body: 'Paste a maps link, import GPX, or tap stops on the map.',
    img: '/images/app/projects.png',
    alt: 'Wander projects screen with a Garden Route project card',
  },
  {
    n: '2',
    title: 'Style',
    body: '18 map styles, including Golden Hour, Midnight Drive, Film, and satellite.',
    img: '/images/app/style.png',
    alt: 'Wander style picker with topographic, satellite, and glow settings',
  },
  {
    n: '3',
    title: 'Export',
    body: 'Export 1080p or 4K for Instagram, TikTok, and YouTube.',
    img: '/images/app/export.png',
    alt: 'Wander export screen with aspect ratio and resolution options',
  },
];
---

<section id="features" class="scroll-mt-20 py-12 md:py-20">
  <div class="container-site grid gap-6 md:grid-cols-3">
    {cards.map((card) => (
      <article class="rounded-3xl border border-border bg-surface p-6 shadow-sm">
        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">
          {card.n}
        </div>
        <h3 class="mt-4 text-xl font-bold text-ink">{card.title}</h3>
        <p class="mt-2 text-sm text-ink-muted leading-relaxed">{card.body}</p>

        <div class="mt-5 overflow-hidden rounded-2xl border border-border bg-surface-muted">
          <div class="mx-auto w-full max-w-[200px] overflow-hidden rounded-xl aspect-[9/16]">
            <AppScreenshot src={card.img} alt={card.alt} />
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
