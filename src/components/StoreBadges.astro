---
import { site } from '../config/site';
---

<div class="flex flex-wrap items-center gap-3">
  {site.appStoreUrl ? (
    <a
      href={site.appStoreUrl}
      class="inline-flex h-12 items-center gap-2.5 rounded-xl bg-ink px-4 text-white hover:opacity-90 transition-opacity"
      aria-label="Download on the App Store"
    >
      <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
      </svg>
      <span class="flex flex-col leading-tight text-left">
        <span class="text-[10px] opacity-80">Download on the</span>
        <span class="text-sm font-semibold -mt-0.5">App Store</span>
      </span>
    </a>
  ) : (
    <span
      class="inline-flex h-12 items-center gap-2.5 rounded-xl bg-ink px-4 text-white opacity-90"
      title="Coming soon to the App Store"
      aria-label="App Store — coming soon"
    >
      <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
      </svg>
      <span class="flex flex-col leading-tight text-left">
        <span class="text-[10px] opacity-80">Coming soon on the</span>
        <span class="text-sm font-semibold -mt-0.5">App Store</span>
      </span>
    </span>
  )}

  <a
    href={site.playStoreUrl}
    class="inline-flex h-12 items-center gap-2.5 rounded-xl bg-ink px-4 text-white hover:opacity-90 transition-opacity"
    aria-label="Get it on Google Play"
  >
    <svg class="h-7 w-7" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="#EA4335" d="M3.6 2.4c-.3.2-.5.5-.5.9v17.4c0 .4.2.7.5.9l9.7-9.6L3.6 2.4z" />
      <path fill="#FBBC04" d="M16.5 11.1 13.3 8 3.6 2.4l9.7 9.7 3.2-1z" />
      <path fill="#4285F4" d="M3.6 21.6l9.7-9.7 3.2 3.1-9.4 5.4c-.6.3-1.3.2-1.8-.1-.2-.1-.4-.3-.5-.5-.1-.2-.2-.4-.2-.6v-.6z" />
      <path fill="#34A853" d="M20.1 10.5c.6.3.9.9.9 1.5s-.3 1.2-.9 1.5l-3.6 2.1-3.2-3.1 3.2-3.1 3.6 1.1z" />
    </svg>
    <span class="flex flex-col leading-tight text-left">
      <span class="text-[10px] opacity-80">GET IT ON</span>
      <span class="text-sm font-semibold -mt-0.5">Google Play</span>
    </span>
  </a>
</div>
